# Copy to .env and fill in. All keys the app uses are listed here.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# The one OpenAI model the agent uses.
OPENAI_MODEL=

# Optional for chatting; needed for tracing and `npm run eval`.
# https://www.lmnr.ai (project settings → API keys)
LMNR_PROJECT_API_KEY=
